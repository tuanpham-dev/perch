{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "launcher",
  "description": "The launcher window: the server list and the local server's controls.",
  "windows": ["launcher"],
  "permissions": [
    "core:default",
    "allow-list-servers",
    "allow-add-server",
    "allow-update-server",
    "allow-remove-server",
    "allow-open-server",
    "allow-start-local",
    "allow-stop-local",
    "allow-detect-installed",
    "allow-open-external"
  ]
}
