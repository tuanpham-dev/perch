{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Perch",
  "version": "0.1.0",
  "identifier": "dev.perch.desktop",
  "build": {
    "frontendDist": "../launcher/dist",
    "beforeDevCommand": "node scripts/build-launcher.mjs",
    "beforeBuildCommand": "node scripts/build-launcher.mjs"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "perch"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2QkRBREExNTJFN0ZCRDgKUldUWSsrZFNvYTI5aG11SG00TUdCTVVGazdjNjA3UFVEaWFvVEQrdjRhYXBXMGZYcFAwcDZVZk4K",
      "endpoints": [
        "https://github.com/tuanpham-dev/perch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "app",
      "dmg",
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Your terminals, in a desktop app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/perch/": "perch/"
    },
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-libav",
          "gstreamer1.0-plugins-good"
        ],
        "desktopTemplate": "perch.desktop"
      },
      "rpm": {
        "depends": [
          "gstreamer1-plugins-good"
        ],
        "desktopTemplate": "perch.desktop"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
